---
import type { NavNode } from "../lib/nav";

interface Props {
  nodes: NavNode[];
  currentPath: string;
  depth?: number;
}

const { nodes, currentPath, depth = 0 } = Astro.props;

const base = import.meta.env.BASE_URL;
const toPath = (href: string) =>
  href === "/" ? base : `${base}${href.replace(/^\//, "")}`;
const isActive = (href: string) =>
  currentPath === toPath(href) || currentPath.startsWith(toPath(href));
---

{
  nodes.map((node) => (
    <li class:list={[{ "nav-item": true, active: isActive(node.href) }]}>
      <a
        href={toPath(node.href)}
        class={depth === 0 ? "nav-link nav-link--top" : "nav-link"}
        aria-current={isActive(node.href) ? "page" : undefined}
      >
        {node.title}
      </a>
      {node.children.length > 0 && (
        <ul class="nav-sub">
          <Astro.self
            nodes={node.children}
            currentPath={currentPath}
            depth={depth + 1}
          />
        </ul>
      )}
    </li>
  ))
}